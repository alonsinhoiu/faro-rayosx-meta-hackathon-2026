{
  "name": "faro-rayosx-meta-hackathon-2026",
  "version": "1.0.0",
  "description": "Tenant-Side Multimodal Listing, Photo & Lease Forensic Auditor for the Meta Global AI Developer Hackathon 2026",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch dist/server.js",
    "build": "tsc",
    "client:dev": "npm run dev --prefix client",
    "client:build": "npm run build --prefix client",
    "build:all": "npm run build && npm run client:build",
    "test": "npm run build && node --experimental-strip-types --test tests/**/*.test.ts",
    "smoke:meta": "node --env-file-if-exists=.env scripts/smoke-meta-api.js",
    "eval": "node --env-file-if-exists=.env scripts/evaluate-benchmark.js"
  },
  "keywords": [
    "meta-hackathon-2026",
    "muse-spark-1.3",
    "sam-3.1",
    "muse-voice-transcribe",
    "proptech",
    "tenant-advocate",
    "forensic-auditor"
  ],
  "author": "Alonso Jesús González Céspedes (Dabrianta)",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.1",
    "typescript": "^5.7.2"
  }
}
